# Exemplo de INTEGRAÇÃO — nunca incluir segredos reais.
# Copiar para .env.integration se quiser sobrescrever os padrões.
#
# Estes valores NÃO são os de desenvolvimento: banco, porta e filas são
# dedicados à suíte de integração (`bun run test:integration`).

INTEGRATION_POSTGRES_DB=wagering_integration
INTEGRATION_POSTGRES_USER=wagering_integration
INTEGRATION_POSTGRES_PASSWORD=integration_only_change_me
INTEGRATION_DATABASE_URL=postgresql://wagering_integration:integration_only_change_me@127.0.0.1:5433/wagering_integration

# LocalStack de integração (porta diferente do dev, que usa 4566)
INTEGRATION_SQS_ENDPOINT=http://127.0.0.1:4567
# Fila de entrada de comandos dos provedores (README §10)
INTEGRATION_SQS_QUEUE_NAME=jungle-integration-wager-transactions.fifo
# Fila de saída dos eventos da outbox (README §11) — dedicada, também FIFO
INTEGRATION_SQS_EVENTS_QUEUE_NAME=jungle-integration-wager-events.fifo

# Credenciais fictícias exigidas pelo SigV4 — LocalStack as valida como "test"
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
