# Exemplo local — nunca incluir segredos reais

NODE_ENV=development
PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=postgresql://wagering:local_dev_only_change_me@localhost:5432/wagering

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-commands
SQS_EVENT_QUEUE_URL=http://localhost:4566/000000000000/wager-events

# Opcional: IdP externo
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
