# Exemplo local — nunca incluir segredos reais

NODE_ENV=development
PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=postgresql://wagering:local_dev_only_change_me@localhost:5432/wagering

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
# Entrada de comandos dos provedores (README §10)
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
# Saida dos eventos da outbox (README §11) — fila dedicada, tambem FIFO
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Opcional: IdP externo
OIDC_ISSUER_URL=
OIDC_AUDIENCE=

# Worker de recuperação de referências pendentes (§7.1)
# Intervalo entre ciclos em milissegundos (padrão 5000, mínimo 100).
PENDING_REFERENCE_POLL_MS=5000
# Defina false para não agendar o worker neste processo.
PENDING_REFERENCE_WORKER_ENABLED=true

# Publica a outbox no SQS (README §11)
# Intervalo entre ciclos em milissegundos (padrao 5000, minimo 100).
OUTBOX_POLL_MS=5000
# Defina false para nao agendar o publisher neste processo.
OUTBOX_PUBLISHER_ENABLED=true

# Consome a fila de comandos (README §10) — nao e a fila de eventos
# Intervalo entre ciclos em milissegundos (padrao 5000, minimo 100).
WAGER_CONSUMER_POLL_MS=5000
# Defina false para nao agendar o consumidor neste processo.
WAGER_CONSUMER_ENABLED=true
